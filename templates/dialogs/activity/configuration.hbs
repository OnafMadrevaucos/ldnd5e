<fieldset>
    <legend>{{ localize "ldnd5e.tatics.configuration" }}</legend>
    <div class="form-group">
        <label>{{localize 'ldnd5e.tatics.activityType'}}</label>
        <div class="form-fields">
            <select class="activity-type" name="config.type">
                {{ selectOptions activityTypes labelAttr="label" valueAttr="value" selected=data.type }}
            </select>
        </div>
    </div>

    <div class="form-group split-group full-width card">
        <div class="activity-config form-fields field-groups">
            <div class="field-group">
                <div class="form-group label-top">
                    <label>{{localize 'ldnd5e.tatics.value'}}</label>
                    <div class="activity-value form-fields flexrow">
                        <input type="number" name="config.number" value="{{#if isEdit}}{{data.number}}{{else}}1{{/if}}"
                            min="0" step="1" placeholder="1">
                        <i class="{{icon}}"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
</fieldset>