<header>
    <h1 class="window-title">{{tatic.name}}</h1>
</header>
<section>
    <menu class="unlist">
        {{#each activities}}
        <li>
            <button type="button" data-action="choose" data-activity-id="{{ id }}">
                <span class="icon">                    
                    <i class="{{icon}}"></i>
                </span>
                <span class="name">{{ name }}</span>
            </button>
        </li>
        {{/each}}
    </menu>

    {{#if controlHint}}
    <div class="control-hint ff-hint">{{{ controlHint }}}</div>
    {{/if}}
</section>