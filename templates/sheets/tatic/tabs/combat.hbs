<section class="combat tab {{ tab.cssClass }}" data-tab="{{ tab.id }}" data-group="{{ tab.group }}">
    <fieldset class="tatic-combat">
        <legend>{{localize 'ldnd5e.tatics.details.use'}}</legend>

        <div class="form-group split-group">
            <label>{{localize 'ldnd5e.tatics.combat.attack'}}</label>
            <div class="form-fields">
                <input type="number" name="system.combat.attack" value="{{ system.combat.attack }}" min="0" max="5" {{#unless editable}}
                    disabled{{/unless}}>
            </div>
        </div>

        <div class="form-group split-group">
            <label>{{localize 'ldnd5e.tatics.combat.defense'}}</label>
            <div class="form-fields">
                <input type="number" name="system.combat.defense" value="{{ system.combat.defense }}" min="0" max="5" {{#unless
                    editable}} disabled{{/unless}}>
            </div>
        </div>
    </fieldset>

    <fieldset class="tatic-casualties">
        <legend>{{localize 'ldnd5e.tatics.combat.casualties'}}</legend>

        <div class="form-group split-group">
            <label>{{localize 'ldnd5e.tatics.details.hasCasualties'}}</label>
            <div class="form-fields">                
                <dnd5e-checkbox name="system.combat.casualties.active" tabindex="1" {{#if hasCasualties}}
                    checked{{/if}}></dnd5e-checkbox>                
            </div>
        </div>
        
        <label class="hint">{{localize 'ldnd5e.tatics.details.casualtiesInfo'}}</label>

        {{#if hasCasualties}}
        <div class="form-group split-group">
            <label>{{localize 'ldnd5e.tatics.details.casualtiesNumber'}}</label>
            <div class="form-fields">
                <input type="number" name="system.combat.casualties.value" value="{{ system.combat.casualties.value }}" 
                min="0" max="{{ system.combat.defense }}" {{#unless editable}} disabled{{/unless}}>
            </div>
        </div>
        {{/if}}
    </fieldset>
</section>